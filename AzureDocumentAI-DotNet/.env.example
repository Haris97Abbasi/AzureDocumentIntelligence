# Copy these names into environment variables or .NET User Secrets.
# Never commit real values. Find them in the Azure portal under "Keys and Endpoint".
DOCUMENT_INTELLIGENCE_ENDPOINT=https://<your-resource>.cognitiveservices.azure.com/
DOCUMENT_INTELLIGENCE_KEY=<your-document-intelligence-key>
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=<your-azure-openai-key>
# The deployment name you chose in Azure AI Foundry, not the model ID.
AZURE_OPENAI_DEPLOYMENT=<your-deployment-name>
